# ApplyTrack — Environment Variables
# Copy this file to .env and fill in all blank values before starting.

# ── Database ─────────────────────────────────────────────
# Default points to the docker-compose 'db' container — leave as-is unless using an external DB.
DATABASE_URL=postgresql+asyncpg://jobtracker:jobtracker_password@db:5432/jobtracker

# ── Redis ─────────────────────────────────────────────────
# Default points to the docker-compose 'redis' container — leave as-is.
REDIS_URL=redis://redis:6379/0

# ── Environment ───────────────────────────────────────────
# Set to 'production' on the server. Enables secret validation at startup.
ENVIRONMENT=production

# ── Auth ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Encryption (IMAP passwords + OAuth tokens at rest) ────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Email Parsing (AI) ────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional: Ollama fallback (leave blank if not using)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# ── Payments (Razorpay) ───────────────────────────────────
# Get from: Razorpay dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Get from: Razorpay dashboard → Webhooks → your webhook → Webhook secret
RAZORPAY_WEBHOOK_SECRET=

# ── Inbound Email (Mailgun) ───────────────────────────────
# Get API key from: Mailgun dashboard → API Keys
MAILGUN_API_KEY=
# The sending/receiving domain you set up in Mailgun (e.g. mg.applytrack.online)
MAILGUN_DOMAIN=
# Get from: Mailgun dashboard → Webhooks → HTTP webhook signing key
# NOTE: this is DIFFERENT from the API key above
MAILGUN_WEBHOOK_SIGNING_KEY=
# Random string — used to authenticate generic webhook calls
WEBHOOK_SECRET=

# ── Transactional Email ───────────────────────────────────
INBOX_DOMAIN=inbox.applytrack.online
EMAIL_FROM=noreply@applytrack.online

# ── OAuth2 — Gmail ────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorised redirect URI: https://applytrack.online/api/v1/email-accounts/oauth/google/callback
# 4. Enable the Gmail API and request scope: https://mail.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth2 — Outlook / Microsoft ─────────────────────────
# 1. Go to https://portal.azure.com → App registrations → New registration
# 2. Add redirect URI: https://applytrack.online/api/v1/email-accounts/oauth/microsoft/callback
# 3. Under API permissions add: IMAP.AccessAsUser.All, offline_access, email, openid, profile
# 4. Create a client secret under Certificates & secrets
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── URLs ──────────────────────────────────────────────────
OAUTH_REDIRECT_BASE_URL=https://applytrack.online
FRONTEND_URL=https://applytrack.online
CORS_ORIGINS=https://applytrack.online,https://www.applytrack.online
VITE_API_BASE_URL=https://applytrack.online/api/v1

# ── Admin ─────────────────────────────────────────────────
# Any strong random string — required for /admin/* endpoints
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=
